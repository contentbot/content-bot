# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Anthropic API key -> used to write scripts/hooks/captions
# Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Voice for edge-tts (free, no key needed). Run `edge-tts --list-voices` to see options.
# Good faceless-narration picks: en-US-GuyNeural, en-US-ChristopherNeural, en-GB-RyanNeural
TTS_VOICE=en-US-GuyNeural

# --- YouTube (optional but recommended, since upload can be fully automatic) ---
# 1. Create a project at https://console.cloud.google.com
# 2. Enable "YouTube Data API v3"
# 3. Create OAuth client credentials (type: Desktop app)
# 4. Download the JSON and save it as client_secrets/youtube_client_secret.json
# The first run will open a browser once to authorize; after that it's automatic.
YOUTUBE_CATEGORY_ID=24
YOUTUBE_PRIVACY_STATUS=public

# --- TikTok (optional; see README for why this can't be fully automatic yet) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
